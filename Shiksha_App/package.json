{
  "name": "shiksha-sms",
  "version": "2.3.0",
  "productName": "SHIKSHA – School Management Software",
  "description": "SHIKSHA – School Management Software",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"SHIKSHA\" --platform=win32 --arch=x64 --out=dist --icon=icon.ico --overwrite --asar --ignore=\"dist-installer|test|installer\\.iss|\\.bat$|\\.vbs$|README\\.txt|\\.gitignore|auth\\.json\"",
    "build:installer": "innosetup-compiler installer.iss",
    "dist": "npm run package && npm run build:installer",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.shiksha.sms",
    "productName": "SHIKSHA – School Management Software",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHIKSHA – School Management Software"
    },
    "files": [
      "main.js",
      "auth.js",
      "src/**/*",
      "icon.ico"
    ]
  },
  "devDependencies": {
    "@skyfalcode/inno-setup": "^1.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-installer-windows": "^3.0.0",
    "electron-packager": "^17.1.2",
    "innosetup-compiler": "^6.3.1"
  }
}
